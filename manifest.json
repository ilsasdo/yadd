{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "1.0.0",
  "description": "A grid-based widget dashboard for your Chrome new tab.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "sandbox": {
    "pages": ["widgets/empty/index.html", "widgets/github-prs/index.html"]
  }
}
